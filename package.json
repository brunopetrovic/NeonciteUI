{
  "name": "neoncite-ui",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run build:dist && npm run build:sitemap && vite build",
    "build:dev": "npm run build:dist && npm run build:sitemap && vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "validate:registry": "node scripts/validate-registry-deps.mjs && node scripts/validate-registry-style.mjs && node scripts/validate-registry-accessibility.mjs",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run test:unit && npm run validate:registry && npm run validate:generated && npm run build && npm run test:e2e && npm run check:bundle",
    "validate:generated": "npm run build:dist && npm run build:sitemap && node scripts/validate-generated.mjs",
    "format": "prettier --write .",
    "build:registry": "node scripts/build-registry.mjs",
    "build:package": "node scripts/build-package.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "build:dist": "npm run build:registry && npm run build:package",
    "deploy": "npm run build && wrangler deploy --config wrangler.deploy.jsonc",
    "test:unit": "vitest run",
    "check:bundle": "node scripts/check-core-bundle.mjs",
    "build:analyze": "vite build --mode production && npx vite-bundle-visualizer --open false"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
