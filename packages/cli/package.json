{
  "name": "neoncite",
  "version": "0.2.0",
  "description": "CLI for the Neoncite UI design system",
  "type": "module",
  "bin": {
    "neoncite": "dist/index.js"
  },
  "files": [
    "dist",
    "theme.css"
  ],
  "scripts": {
    "build": "node ../../scripts/build-cli-theme.mjs && tsup src/index.ts --format esm --target node18 --clean",
    "dev": "tsup src/index.ts --format esm --target node18 --watch"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2",
    "zod": "^3.24.0"
  },
  "license": "MIT"
}
